{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Application name."
    },
    "provider": {
      "type": "string",
      "enum": [
        "aws"
      ],
      "description": "Cloud provider every resolution targets."
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "description": "Provider region every environment deploys to."
    },
    "usage": {
      "type": "object",
      "properties": {
        "requestsPerMonth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Expected HTTP requests per month across the application."
        },
        "storageGb": {
          "type": "number",
          "minimum": 0,
          "description": "Expected data stored, in gigabytes."
        }
      },
      "required": [
        "requestsPerMonth",
        "storageGb"
      ],
      "additionalProperties": false,
      "description": "Usage profile: the expected load every estimate and recommendation is relative to."
    },
    "intents": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "http-api"
              },
              "resolution": {
                "type": "string",
                "minLength": 1,
                "description": "The concrete kind of cloud resources chosen for this intent on the provider."
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "description": "Path of the tier's entry module, relative to the blueprint."
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "to": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "description": "Name of the intent this tier is linked to."
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "read-write"
                      ],
                      "description": "How the tier uses the linked intent. Valid roles depend on the target intent's kind."
                    }
                  },
                  "required": [
                    "to",
                    "role"
                  ],
                  "additionalProperties": false,
                  "description": "A directional link from this tier to an intent, carrying a role."
                }
              }
            },
            "required": [
              "kind",
              "resolution",
              "entry"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "relational-database"
              },
              "resolution": {
                "type": "string",
                "minLength": 1,
                "description": "The concrete kind of cloud resources chosen for this intent on the provider."
              }
            },
            "required": [
              "kind",
              "resolution"
            ],
            "additionalProperties": false
          }
        ],
        "description": "An intent: an architectural need, with the resolution chosen for it."
      },
      "description": "The intents of the application, by name."
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "usage": {
            "description": "Usage profile values that replace the blueprint's for this environment.",
            "type": "object",
            "properties": {
              "requestsPerMonth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Expected HTTP requests per month across the application."
              },
              "storageGb": {
                "type": "number",
                "minimum": 0,
                "description": "Expected data stored, in gigabytes."
              }
            },
            "additionalProperties": false
          },
          "policies": {
            "description": "Blueprint-wide policies. None exist in v0.",
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "overrides": {
            "description": "Per-intent pins of sizing parameters, replacing the derived value.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        "additionalProperties": false,
        "description": "An environment: a deployed instance of the blueprint. It may change usage, policies and overrides, never kinds or resolutions."
      },
      "description": "The environments of the application, by name."
    }
  },
  "required": [
    "name",
    "provider",
    "region",
    "usage",
    "intents",
    "environments"
  ],
  "additionalProperties": false,
  "title": "Hull blueprint (v0)",
  "description": "Declares an application's architecture as intents."
}
