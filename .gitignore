# JetBrains IDE project files (per-developer)
.idea/

# Claude Code "remember" plugin session memory (per-developer)
.remember/

# OS
.DS_Store

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
coverage/

# Hull working state written by the CLI, never hand-edited: the generated
# bindings and the deploy secrets passphrase stay out; .hull/state.json is
# committed so a second machine deploys against the same state bucket
**/.hull/bindings/
**/.hull/passphrase

# Per-developer environment (direnv); holds AWS credentials, never committed
.envrc
