{
  "name": "todos",
  "version": "0.0.0",
  "private": true,
  "description": "The application deployed by the demo script: an HTTP API on Lambda that reads todos from RDS Postgres and enqueues new ones for a Lambda worker fed by SQS",
  "type": "module",
  "scripts": {
    "bindings": "tsx --conditions=@hull/source scripts/bindings.ts",
    "typecheck": "pnpm bindings && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1131.0",
    "hono": "^4.13.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@hull/blueprint": "workspace:*",
    "@hull/catalog": "workspace:*",
    "@hull/compiler": "workspace:*"
  }
}
