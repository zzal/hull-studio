{
  "name": "@hull/catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Intents, resolutions, sizing, cost models, pricing snapshot, recommendation rules",
  "type": "module",
  "exports": {
    ".": {
      "@hull/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pricing"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "refresh-pricing": "tsx --conditions=@hull/source scripts/refresh-pricing.ts"
  },
  "dependencies": {
    "@hull/blueprint": "workspace:*",
    "zod": "^4.6.2"
  }
}
