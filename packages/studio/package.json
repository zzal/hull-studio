{
  "name": "@hull/studio",
  "version": "0.0.0",
  "private": true,
  "description": "Local HTTP and WebSocket server over the blueprint, React dashboard",
  "type": "module",
  "exports": {
    ".": {
      "@hull/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hull/blueprint": "workspace:*",
    "@hull/catalog": "workspace:*",
    "chokidar": "^5.0.0",
    "hono": "^4.13.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.11.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  }
}
