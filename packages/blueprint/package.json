{
  "name": "@hull/blueprint",
  "version": "0.0.0",
  "private": true,
  "description": "hull.yaml load and save with comments preserved, Zod model, JSON Schema export, environment resolution",
  "type": "module",
  "exports": {
    ".": {
      "@hull/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  }
}
