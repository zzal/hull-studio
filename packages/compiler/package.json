{
  "name": "@hull/compiler",
  "version": "0.0.0",
  "private": true,
  "description": "Resolved blueprint to Pulumi program, tier bundling, binding module and env-var contract",
  "type": "module",
  "exports": {
    ".": {
      "@hull/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bindings": {
      "@hull/source": "./src/bindings.ts",
      "types": "./dist/bindings.d.ts",
      "import": "./dist/bindings.js"
    },
    "./resolve": {
      "@hull/source": "./src/resolve.ts",
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hull/blueprint": "workspace:*",
    "@hull/catalog": "workspace:*",
    "@pulumi/aws": "^7.46.0",
    "@pulumi/pulumi": "^3.262.0",
    "esbuild": "^0.28.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1131.0"
  }
}
